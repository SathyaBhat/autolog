owntracks:
  url: "https://your-otrecorder-host/otrecorder"
  user: "yourname"
  device: "yourphone"

telegram:
  bot_token: "123456:ABC-DEF..."
  chat_id: "123456789"

scheduler:
  interval: 6h

filters:
  max_train_speed_kmh: 150
  exclusion_zones:
    - name: "home train station"
      lat: 51.5074
      lon: -0.1278
      radius_m: 300

store:
  path: "/data/autolog.db"

log:
  level: info
