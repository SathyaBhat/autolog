owntracks:
  url: "https://your-otrecorder-host/otrecorder"
  user: "yourname"
  device: "yourphone"

telegram:
  bot_token: "123456:ABC-DEF..."
  chat_id: "123456789"

filters:
  max_train_speed_kmh: 150
  # Extra radius allowed for a delayed first GPS fix when starting at home.
  start_home_grace_m: 500
  algorithm_flags:
    anomaly_filter: true
    accel_train_gate: true
  exclusion_zones:
    - name: "work"
      lat: 0.0000
      lon: 0.0000
      radius_m: 500
  home_zones:
    - name: "Home"
      lat: 0.0000
      lon: 0.0000
      radius_m: 500
  # Zones can also be set via env vars (semicolon-separated, each entry is lat,lon,radius_m,name):
  # AUTOLOG_HOME_ZONES="<lat>,<lon>,500,Home"
  # AUTOLOG_EXCLUSION_ZONES="<lat>,<lon>,500,Work"

store:
  path: "/data/autolog.db"

log:
  level: info
